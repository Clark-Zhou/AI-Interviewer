# DeepSeek server-side API configuration.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash

# Supabase Auth public browser/server configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# Resume library server-only token generated by the SQL setup. Never use NEXT_PUBLIC_.
SUPABASE_RESUME_API_TOKEN=copy_token_from_private_resume_api_config
